Options -Indexes
RewriteEngine On

# Force HTTPS (disabled on localhost)
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Remove .php extension (chỉ áp dụng GET, không redirect POST để tránh mất data AJAX)
RewriteCond %{THE_REQUEST} /([^.]+)\.php [NC]
RewriteCond %{REQUEST_METHOD} !POST
RewriteRule ^ /%1 [R=301,L,NE]

# Room slug URLs: /room/ten-phong -> room_details.php?slug=ten-phong
RewriteRule ^room/([^/]+)/?$ room_details.php?slug=$1 [L,QSA]

# Internally rewrite clean URLs to .php files
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^.]+)$ $1.php [L]
